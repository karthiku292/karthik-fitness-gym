# Copy to deploy/.env.prod and fill in real values. NEVER commit the real file.

# Your domain (DNS A-record must point to the instance's public IP).
DOMAIN=karthikfitness.com
# Full public URL, used for backend CORS. Use https once the domain works.
PUBLIC_URL=https://karthikfitness.com

# App
APP_NAME=KARTHIK FITNESS GYM

# Security — generate a long random value:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# Postgres (kept private inside Docker)
POSTGRES_USER=gym
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=gym

# First admin created on first boot (use YOUR email/password)
BOOTSTRAP_GYM_NAME=KARTHIK FITNESS GYM
BOOTSTRAP_ADMIN_EMAIL=karthiknagidi42@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_password
