# Copy to deploy/.env.ip and fill in real values. Never commit the real file.

# Your instance's PUBLIC IP (from AWS/DigitalOcean console).
PUBLIC_URL=http://YOUR_PUBLIC_IP

APP_NAME=KARTHIK FITNESS GYM

# Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# Postgres (private inside Docker)
POSTGRES_USER=gym
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=gym

# First admin created on first boot (use YOUR login)
BOOTSTRAP_GYM_NAME=KARTHIK FITNESS GYM
BOOTSTRAP_ADMIN_EMAIL=karthiknagidi42@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_password
